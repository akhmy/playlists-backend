{
  "info": {
    "name": "Playlists API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "access_token", "value": "" },
    { "key": "playlist_id", "value": "1" },
    { "key": "track_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/users/", "host": ["{{base_url}}"], "path": ["auth", "users", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"testpassword123\",\n  \"email\": \"test@example.com\"\n}"
            }
          }
        },
        {
          "name": "Login (get JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access) {",
                  "  pm.collectionVariables.set('access_token', json.access);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/jwt/create/", "host": ["{{base_url}}"], "path": ["auth", "jwt", "create", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"testpassword123\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/auth/jwt/logout/", "host": ["{{base_url}}"], "path": ["auth", "jwt", "logout", ""] },
            "body": { "mode": "raw", "raw": "{}" }
          }
        }
      ]
    },
    {
      "name": "Tracks",
      "item": [
        {
          "name": "List Tracks",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/tracks/", "host": ["{{base_url}}"], "path": ["tracks", ""] }
          }
        },
        {
          "name": "Search Tracks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tracks/?search=rock",
              "host": ["{{base_url}}"],
              "path": ["tracks", ""],
              "query": [{ "key": "search", "value": "rock" }]
            }
          }
        },
        {
          "name": "Get Track",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/tracks/{{track_id}}/", "host": ["{{base_url}}"], "path": ["tracks", "{{track_id}}", ""] }
          }
        }
      ]
    },
    {
      "name": "Playlists",
      "item": [
        {
          "name": "List Playlists",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/playlists/", "host": ["{{base_url}}"], "path": ["playlists", ""] }
          }
        },
        {
          "name": "Trending Playlists",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/playlists/trending/", "host": ["{{base_url}}"], "path": ["playlists", "trending", ""] }
          }
        },
        {
          "name": "Get Playlist",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/playlists/{{playlist_id}}/", "host": ["{{base_url}}"], "path": ["playlists", "{{playlist_id}}", ""] }
          }
        },
        {
          "name": "Create Playlist",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/playlists/", "host": ["{{base_url}}"], "path": ["playlists", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Playlist\",\n  \"description\": \"A test playlist\",\n  \"tracks\": []\n}"
            }
          }
        },
        {
          "name": "Upvote Playlist",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/playlists/{{playlist_id}}/upvote/", "host": ["{{base_url}}"], "path": ["playlists", "{{playlist_id}}", "upvote", ""] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get User by Username",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/users/testuser/", "host": ["{{base_url}}"], "path": ["users", "testuser", ""] }
          }
        }
      ]
    }
  ]
}
